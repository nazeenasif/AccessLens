# AccessLens environment template — PLACEHOLDERS ONLY. Copy to .env and fill in locally.
# Never commit real values. Service scoping follows ADR-0001's secret table:
#   web           -> OPENROUTER_*, AI_*, EVIDENCE_SIGNING_*, SCANNER_*, RL_*, TRUSTED_PROXY_HOPS, SCAN_ENABLED
#   scanner       -> SCANNER_INTERNAL_TOKEN, PROXY_CONTROL_TOKEN, SCAN_* limits
#   egress-proxy  -> PROXY_CONTROL_TOKEN, SCAN_MAX_BYTES, SCAN_MAX_REQUESTS
# Neither scanner nor egress-proxy may receive OPENROUTER_* or EVIDENCE_SIGNING_*.

# --- web (server only) ---------------------------------------------------------------
# Live scanning of arbitrary URLs. MUST stay false until G0 + G1 evidence exists for this host.
SCAN_ENABLED=false
# AI provider: openrouter | none (kill switch)
AI_PROVIDER=openrouter
# Leave empty to run with AI disabled. Never prefix with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Choose a model that supports structured outputs.
OPENROUTER_MODEL=
AI_MAX_OUTPUT_TOKENS=900
AI_TIMEOUT_MS=20000
AI_DAILY_REQUEST_CAP=500
AI_EXPLAINS_PER_AUDIT=25
# 32+ random bytes, base64 (e.g. `openssl rand -base64 48`). REQUIRED.
EVIDENCE_SIGNING_SECRET=replace-with-random-secret
# Rotation only: previous value, removed 7 days after rotation.
EVIDENCE_SIGNING_SECRET_PREVIOUS=
SCANNER_URL=http://scanner:4001
TRUSTED_PROXY_HOPS=0
RL_AUDITS_PER_10M=5
RL_EXPLAINS_PER_10M=20

# --- web + scanner -------------------------------------------------------------------
# 32+ random bytes; same value in web and scanner. REQUIRED.
SCANNER_INTERNAL_TOKEN=replace-with-random-token

# --- scanner + egress-proxy ----------------------------------------------------------
# 32+ random bytes; same value in scanner and egress-proxy. Never given to web. REQUIRED.
PROXY_CONTROL_TOKEN=replace-with-random-token

# --- scanner -------------------------------------------------------------------------
SCAN_NAV_TIMEOUT_MS=30000
SCAN_ANALYSIS_BUDGET_MS=20000
SCAN_TEARDOWN_MS=5000
SCAN_TOTAL_TIMEOUT_MS=60000
SCAN_MAX_DOM_ELEMENTS=50000
SCAN_CONCURRENCY=2
SCAN_QUEUE=4

# --- egress-proxy (enforced) + scanner (reported) ------------------------------------
SCAN_MAX_BYTES=15728640
SCAN_MAX_REQUESTS=300

# --- all services --------------------------------------------------------------------
LOG_LEVEL=info
